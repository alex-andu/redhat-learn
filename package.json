{
  "name": "rhcsa-learn",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Platformă educațională RHCSA EX200 (RHEL 10), în română. SPA statică (fundație preluată din arhitectura CCNA Learn); nu execută și nu verifică sisteme externe.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:matrix": "node scripts/check-matrix.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:matrix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
